// AEGIS rule file (YARA-lite). Install with:  aegis rules add rules.example
// Rules are FUSED into the Bayesian consensus, never a bypass:
//   severity = "block"   -> force BLOCK (the allowlist still overrides it)
//   severity = "review"  -> surfaced for a human, never silently allowed
//   severity = "score"   -> a plain weighted vote the ensemble weighs
// A malformed condition never crashes a scan; it falls back to "N of them".

rule Campaign_Beacon {
    meta:
        severity = "review"
    strings:
        $host = "beacon.attacker.test"
        $run  = "CurrentVersion\\Run"
        $stub = { 60 BE ?? ?? ?? ?? 57 }     // hex, ?? = any byte
    condition:
        2 of them
}

rule Packed_PE_With_C2 {
    meta:
        severity = "score"
        weight   = 1.5
    strings:
        $mz  = { 4D 5A }
        $c2  = /https?:\/\/[0-9]{1,3}(\.[0-9]{1,3}){3}/
        $stub = { 60 BE ?? ?? ?? ?? }
    condition:
        $mz at 0 and ($c2 or #stub >= 2) and filesize < 2MB
}
